# --- Supabase (obligatoire) -------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé « service_role » : sert uniquement à l'import de livres côté serveur.
# NE JAMAIS l'exposer au navigateur, ne jamais la committer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Site -------------------------------------------------------------------
# En local : http://localhost:3000 — en prod : https://votre-domaine.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Aucune autre clé n'est nécessaire.
# Open Library et Google Books sont interrogés sans authentification.
